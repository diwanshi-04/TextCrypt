{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Android Debug",
			"type": "shell",
			"command": ".\\gradlew",
			"args": [
				"assembleDebug"
			],
			"problemMatcher": [
				"$gradle"
			],
			"group": "build"
		},
		{
			"label": "Install Android Debug",
			"type": "shell",
			"command": ".\\gradlew",
			"args": [
				"installDebug"
			],
			"problemMatcher": [
				"$gradle"
			],
			"group": "run"
		}
	]
}